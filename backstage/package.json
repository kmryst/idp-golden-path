{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22 || 24"
  },
  "scripts": {
    "start": "node scripts/start-with-config.js",
    "build:backend": "yarn workspace backend build",
    "build:all": "backstage-cli repo build --all",
    "config:check": "yarn config:check:development && yarn config:check:production",
    "config:check:development": "node scripts/check-config.js development",
    "config:check:production": "node scripts/check-config.js production",
    "build-image": "yarn workspace backend build-image",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "test:e2e": "playwright test",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/main",
    "lint:all": "backstage-cli repo lint",
    "prettier:check": "prettier --check .",
    "new": "backstage-cli new"
  },
  "backstage": {
    "cli": {
      "new": {
        "globals": {
          "license": "UNLICENSED"
        }
      }
    }
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "devDependencies": {
    "@backstage/cli": "^0.36.3",
    "@backstage/cli-defaults": "^0.1.3",
    "@backstage/e2e-test-utils": "^0.1.2",
    "@jest/environment-jsdom-abstract": "~30.4.1",
    "@playwright/test": "^1.32.3",
    "@types/jest": "^30.0.0",
    "jest": "~30.4.2",
    "jsdom": "^29.1.1",
    "node-gyp": "^13.0.1",
    "prettier": "^3.9.5",
    "typescript": "~6.0.3"
  },
  "resolutions": {
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "adm-zip": "^0.6.0",
    "brace-expansion@npm:^1.1.7": "1.1.18",
    "brace-expansion@npm:^2.0.1": "2.1.4",
    "brace-expansion@npm:^2.0.2": "2.1.4",
    "brace-expansion@npm:^5.0.5": "5.0.9",
    "fast-uri@npm:^3.0.1": "3.1.5",
    "fast-xml-parser@npm:^5.3.4": "5.10.1",
    "fast-xml-parser@npm:^5.5.1": "5.10.1",
    "fast-xml-parser@npm:^5.5.9": "5.10.1",
    "ip-address@npm:^10.1.1": "10.4.0",
    "ip-address@npm:^10.2.0": "10.4.0",
    "js-yaml@npm:=4.2.0": "4.3.1",
    "postcss@npm:^8.1.0": "8.5.25",
    "postcss@npm:^8.4.33": "8.5.25",
    "protobufjs": "^7.6.5",
    "svgo@npm:^2.7.0": "2.8.3",
    "undici@npm:7.28.0": "7.29.0",
    "undici@npm:^7.21.0": "7.29.0",
    "undici@npm:^7.24.0": "7.29.0",
    "undici@npm:^7.24.5": "7.29.0",
    "undici@npm:^7.25.0": "7.29.0",
    "undici@npm:^8.4.1": "8.9.0"
  },
  "prettier": "@backstage/cli/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.13.0"
}
